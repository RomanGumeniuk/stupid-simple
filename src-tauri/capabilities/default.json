{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Stupid Simple main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*.googleapis.com/*" },
        { "url": "https://accounts.google.com/*" }
      ]
    }
  ]
}
