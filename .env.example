# Optional — only needed if you build from source and want the keys baked in.
# If you installed Stupid Simple from a release, just click "Connect Google
# Calendar" — release builds ship with a built-in OAuth client.
#
# Copy this file to .env and fill in your values from Google Cloud Console
# (OAuth client of type "Desktop app" — see README "Google setup").
# Keep real keys in .env (gitignored), NOT here.
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
